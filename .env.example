APP_ENV=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# YouCam / Perfect Corp — Bearer API key (console: yce.perfectcorp.com / yce.makeupar.com)
YOUCAM_API_KEY=
YOUCAM_API_SECRET=
YOUCAM_BASE_URL=https://yce-api-01.makeupar.com

# LLM — Groq is used first; Gemini only if Groq errors
GROQ_API_KEY=
GOOGLE_API_KEY=
LLM_PRIMARY=groq
LLM_PRIMARY_MODEL=openai/gpt-oss-120b
LLM_FALLBACK=gemini
LLM_FALLBACK_MODEL=gemini-2.0-flash

# Fusion
VTO_TOP_K=3
MAX_CANDIDATES=30
WEAK_SCORE_THRESHOLD=55

# Supabase — project URL + publishable + secret are enough
# Publishable (sb_publishable_...) → SUPABASE_ANON_KEY
# Secret (sb_secret_...)           → SUPABASE_SERVICE_ROLE_KEY
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
AUTH_DISABLED=true

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
